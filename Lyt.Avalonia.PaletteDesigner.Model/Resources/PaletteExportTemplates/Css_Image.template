:root
{
/* ImagePalette - Autogenerated by Palette Designer: <%= DateTime.Now %> */

<%=BEGIN_LOOP:Colors%>
	--color_<%= LoopIndex %>: <%= LoopValue %>
<%=END_LOOP%>

	/* Five Shades of Gray, excluding Pure White and Pure Black */
	--gray_lighter: #FFD5D5D5
	--gray_light: #FFAAAAAA
	--gray_base: #FF808080
	--gray_dark: #FF555555
	--gray_darker: #FF2A2A2A

	/* Pure White and Pure Black */
	--pure_white: #FFFFFFFF
	--pure_black: #FF000000
}
