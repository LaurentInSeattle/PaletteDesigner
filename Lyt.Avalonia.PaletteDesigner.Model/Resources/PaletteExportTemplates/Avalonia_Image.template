<Styles 
	xmlns=""https://github.com/avaloniaui""
	xmlns:x=""http://schemas.microsoft.com/winfx/2006/xaml""
	>
	<Design.PreviewWith>
		<Border 
			Padding=""20""
			>
			<!-- Add Controls for Previewer Here -->
		</Border>
	</Design.PreviewWith>

	<!-- Image Palette - Autogenerated by Palette Designer: <%= DateTime.Now %> -->

	<Style>
		<Style.Resources>

		<%=BEGIN_LOOP:Colors%>
			<Color x:Key="Color_<%= LoopIndex %>"><%= LoopValue %></Color>
			<SolidColorBrush x:Key="Brush_<%= LoopIndex %>" Color ="{StaticResource Color_<%= LoopIndex %>}" />
		<%=END_LOOP%>

			<!-- Five Shades of Gray, excluding Pure White and Pure Black  -->
			<Color x:Key="Gray_Lighter_Color">#FFD5D5D5</Color>
			<SolidColorBrush x:Key="Gray_Lighter" Color ="{StaticResource Gray_Lighter_Color}" />

			<Color x:Key="Gray_Light_Color">#FFAAAAAA</Color>
			<SolidColorBrush x:Key="Gray_Light" Color ="{StaticResource Gray_Light_Color}" />

			<Color x:Key="Gray_Base_Color">#FF808080</Color>
			<SolidColorBrush x:Key="Gray_Base" Color ="{StaticResource Gray_Base_Color}" />

			<Color x:Key="Gray_Dark_Color">#FF555555</Color>
			<SolidColorBrush x:Key="Gray_Dark" Color ="{StaticResource Gray_Dark_Color}" />

			<Color x:Key="Gray_Darker_Color">#FF2A2A2A</Color>
			<SolidColorBrush x:Key="Gray_Darker" Color ="{StaticResource Gray_Darker_Color}" />

		</Style.Resources>
	</Style>
</Styles>
