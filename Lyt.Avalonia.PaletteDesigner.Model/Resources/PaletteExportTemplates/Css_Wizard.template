:root
{
	/* 'Wizard' Palette - Autogenerated by Palette Designer: <%= DateTime.Now %> */

	/* Light Theme */
	--light_theme_background:  <%= LightTheme_Background_ColorValue %>
	--light_theme_foreground:  <%= LightTheme_Foreground_ColorValue %>
	--light_theme_accent:      <%= LightTheme_Accent_ColorValue %>
	--light_theme_discordant:  <%= LightTheme_Discordant_ColorValue %>

	/* Dark Theme */
	--dark_theme_background:  <%= DarkTheme_Background_ColorValue %>
	--dark_theme_foreground:  <%= DarkTheme_Foreground_ColorValue %>
	--dark_theme_accent:      <%= DarkTheme_Accent_ColorValue %>
	--dark_theme_discordant:  <%= DarkTheme_Discordant_ColorValue %>

	/* Lighter Colors */
<%=BEGIN_LOOP:LighterColors%>
	--lighter_color_<%= LoopIndex %>: <%= LoopValue %>
<%=END_LOOP%>

	/* Light Colors */
<%=BEGIN_LOOP:LightColors%>
	--light_color_<%= LoopIndex %>: <%= LoopValue %>
<%=END_LOOP%>

	/* Base Colors */
<%=BEGIN_LOOP:BaseColors%>
	--base_color_<%= LoopIndex %>: <%= LoopValue %>
<%=END_LOOP%>

	/* Dark Colors */
<%=BEGIN_LOOP:DarkColors%>
	--dark_color_<%= LoopIndex %>: <%= LoopValue %>
<%=END_LOOP%>

	/* Darker Colors */
<%=BEGIN_LOOP:DarkerColors%>
	--darker_color_<%= LoopIndex %>: <%= LoopValue %>
<%=END_LOOP%>

	/* Five Shades of Gray, excluding Pure White and Pure Black */
	--gray_lighter: #FFD5D5D5
	--gray_light: #FFAAAAAA
	--gray_base: #FF808080
	--gray_dark: #FF555555
	--gray_darker: #FF2A2A2A

	/* Pure White and Pure Black */
	--pure_white: #FFFFFFFF
	--pure_black: #FF000000
}
